{
  "rules": {
    "posts":    { ".read": true, ".write": "auth != null && root.child('admins/' + auth.uid).exists()" },
    "settings": { ".read": true, ".write": "auth != null && root.child('admins/' + auth.uid).exists()" },
    "users": { "$uid": {
      ".read":  "auth != null && (auth.uid === $uid || root.child('admins/' + auth.uid).exists())",
      ".write": "auth != null && auth.uid === $uid" } },
    "admins": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } }
  }
}
